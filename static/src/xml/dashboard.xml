<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="centro_canino_dashboard.Dashboard" owl="1">

  <!-- ── LOADING ──────────────────────────────────────────────────────── -->
  <t t-if="state.loading">
    <div class="cc-dashboard-loading">
      <div class="cc-spinner"/>
      <span>Cargando dashboard…</span>
    </div>
  </t>

  <!-- ── DASHBOARD ────────────────────────────────────────────────────── -->
  <t t-elif="state.data">
    <div class="cc-dashboard">

      <!-- TOP BAR -->
      <div class="cc-topbar">
        <div class="cc-topbar-title">
          <span class="cc-paw">🐾</span>
          <h1>Centro Canino — Dashboard</h1>
        </div>
        <div class="cc-controls">
          <select t-on-change="onSubtipoChange" class="cc-select">
            <option value="">Todos los servicios</option>
            <t t-foreach="state.data.subtipos" t-as="s" t-key="s.id">
              <option t-att-value="s.id"
                      t-att-selected="state.filtroSubtipo == s.id">
                <t t-esc="s.name"/>
              </option>
            </t>
          </select>
          <select t-on-change="onPeriodoChange" class="cc-select" t-att-value="state.periodo">
            <option value="7"   t-att-selected="state.periodo === '7'">Últimos 7 días</option>
            <option value="30"  t-att-selected="state.periodo === '30'">Últimos 30 días</option>
            <option value="90"  t-att-selected="state.periodo === '90'">Últimos 90 días</option>
            <option value="365" t-att-selected="state.periodo === '365'">Este año</option>
            <option value="all" t-att-selected="state.periodo === 'all'">Todo el historial</option>
          </select>
          <button class="cc-btn-refresh" t-on-click="onRefresh" title="Actualizar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 4v6h-6M1 20v-6h6"/>
              <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 1 – KPIs HOY
           Visible para: Pet Sitter User + Pet Sitter Manager
      ═══════════════════════════════════════════════════════════════════ -->
      <div class="cc-section">
        <span class="cc-badge">Hoy</span>
        <div class="cc-metrics">

          <div class="cc-metric" t-on-click="() => openOcupaciones('in')">
            <div class="cc-metric-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M4.5 11a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM19.5 11a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"/>
                <path d="M8.5 7a4 4 0 017 0"/>
                <ellipse cx="12" cy="16" rx="5" ry="4"/>
                <path d="M9 20c0 1.1.9 2 2 2h2a2 2 0 002-2"/>
              </svg>
            </div>
            <span class="cc-metric-label">Perros dentro</span>
            <span class="cc-metric-value"><t t-esc="state.data.hoy.ocupaciones_in"/></span>
          </div>

          <div class="cc-metric">
            <div class="cc-metric-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
              </svg>
            </div>
            <span class="cc-metric-label">Ocupación Jaulas</span>
            <span class="cc-metric-value">
              <t t-esc="state.data.hoy.tasa_ocupacion"/>%
            </span>
            <span class="cc-metric-sub">
              <t t-esc="state.data.hoy.ocupaciones_in"/> /
              <t t-esc="state.data.hoy.total_bungalows"/> jaulas
            </span>
          </div>

          <div class="cc-metric" t-on-click="() => openOcupaciones('checkin')">
            <div class="cc-metric-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/>
              </svg>
            </div>
            <span class="cc-metric-label">Check-ins pendientes</span>
            <span t-att-class="state.data.hoy.pending_checkins > 0 ? 'cc-metric-value cc-warn' : 'cc-metric-value'">
              <t t-esc="state.data.hoy.pending_checkins"/>
            </span>
          </div>

          <div class="cc-metric" t-on-click="() => openOcupaciones('checkout')">
            <div class="cc-metric-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
              </svg>
            </div>
            <span class="cc-metric-label">Check-outs pendientes</span>
            <span t-att-class="state.data.hoy.pending_checkouts > 0 ? 'cc-metric-value cc-warn' : 'cc-metric-value'">
              <t t-esc="state.data.hoy.pending_checkouts"/>
            </span>
          </div>

          <div class="cc-metric cc-metric-alert"
               t-att-class="state.data.hoy.alertas_medicas > 0 ? 'cc-metric cc-metric-alert' : 'cc-metric'"
               t-on-click="() => openOcupaciones('alertas')">
            <div class="cc-metric-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
              </svg>
            </div>
            <span class="cc-metric-label">Cuidados especiales</span>
            <span t-att-class="state.data.hoy.alertas_medicas > 0 ? 'cc-metric-value cc-alert' : 'cc-metric-value'">
              <t t-esc="state.data.hoy.alertas_medicas"/>
            </span>
          </div>

          <div class="cc-metric cc-metric-bonos" t-on-click="() => openBonos()">
            <div class="cc-metric-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="2" y="7" width="20" height="10" rx="2"/>
                <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
                <line x1="12" y1="12" x2="12" y2="12" stroke-width="3"/>
                <path d="M8 12h.01M12 12h.01M16 12h.01" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
            </div>
            <span class="cc-metric-label">Bonos con saldo</span>
            <span t-att-class="state.data.bonos_activos > 0 ? 'cc-metric-value cc-bonos' : 'cc-metric-value'">
              <t t-esc="state.data.bonos_activos"/>
            </span>
          </div>

        </div>
      </div>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 2 – KPIs PERIODO
           Visible para: Pet Sitter Manager únicamente
      ═══════════════════════════════════════════════════════════════════ -->
      <t t-if="state.data.user_is_manager">
        <div class="cc-section">
          <span class="cc-badge"><t t-esc="state.data.periodo.label_periodo"/></span>
          <div class="cc-metrics">

            <div class="cc-metric" t-on-click="() => openOcupaciones('reservas')">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="4" width="18" height="18" rx="2"/>
                  <path d="M16 2v4M8 2v4M3 10h18"/>
                  <path d="M9 16l2 2 4-4" stroke-width="2"/>
                </svg>
              </div>
              <span class="cc-metric-label">Total Reservas</span>
              <span class="cc-metric-value"><t t-esc="state.data.periodo.total_reservas"/></span>
            </div>

            <div class="cc-metric">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="2" y="6" width="20" height="14" rx="2"/>
                  <circle cx="12" cy="13" r="3"/>
                  <path d="M7 6V4a1 1 0 011-1h8a1 1 0 011 1v2"/>
                </svg>
              </div>
              <span class="cc-metric-label">Ingresos</span>
              <span class="cc-metric-value cc-positive"><t t-esc="state.data.periodo.ingresos_fmt"/></span>
            </div>

            <div class="cc-metric">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                </svg>
              </div>
              <span class="cc-metric-label">Cancelaciones</span>
              <span class="cc-metric-value cc-warn"><t t-esc="state.data.periodo.canceladas"/></span>
            </div>

            <div class="cc-metric">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <span class="cc-metric-label">Días promedio estancia</span>
              <span class="cc-metric-value"><t t-esc="state.data.periodo.dias_promedio"/></span>
            </div>

          </div>
        </div>
      </t>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 3 – GRÁFICAS
           Visible para: Pet Sitter Manager únicamente
      ═══════════════════════════════════════════════════════════════════ -->
      <t t-if="state.data.user_is_manager">
        <div class="cc-charts-row">

          <div class="cc-chart-card cc-chart-bars">
            <div class="cc-chart-title">Entradas por día</div>
            <div class="cc-bar-chart">
              <t t-foreach="state.data.grafica_diaria" t-as="dia" t-key="dia.fecha">
                <div class="cc-bar-group" t-att-title="dia.reservas + ' entradas el ' + dia.fecha">
                  <div class="cc-bar" t-att-style="'height: ' + dia.pct + '%'"/>
                  <span class="cc-bar-label"><t t-esc="dia.fecha"/></span>
                </div>
              </t>
            </div>
          </div>

          <div class="cc-chart-card cc-chart-donut">
            <div class="cc-chart-title">Por subtipo de servicio</div>
            <div class="cc-donut-wrap">
              <svg class="cc-donut-svg" viewBox="0 0 130 130" width="150" height="150">
                <circle cx="65" cy="65" r="54" fill="none" stroke="#e0e4ea" stroke-width="16"/>
                <t t-foreach="state.data.grafica_subtipo" t-as="seg" t-key="seg.id">
                  <circle
                    cx="65" cy="65" r="54"
                    fill="none"
                    t-att-stroke="seg.color"
                    stroke-width="16"
                    t-att-stroke-dasharray="seg.dash_array"
                    t-att-stroke-dashoffset="seg.dash_offset"
                    transform="rotate(-90 65 65)"
                  >
                    <title><t t-esc="seg.name"/>: <t t-esc="seg.count"/> (<t t-esc="seg.pct"/>%)</title>
                  </circle>
                </t>
                <text x="65" y="62" text-anchor="middle" class="cc-donut-num">
                  <t t-esc="state.data.periodo.total_reservas"/>
                </text>
                <text x="65" y="76" text-anchor="middle" class="cc-donut-sub">reservas</text>
              </svg>
              <div class="cc-donut-legend">
                <t t-foreach="state.data.grafica_subtipo" t-as="seg" t-key="seg.id">
                  <div class="cc-legend-item">
                    <span class="cc-legend-dot" t-att-style="'background: ' + seg.color"/>
                    <span class="cc-legend-name"><t t-esc="seg.name"/></span>
                    <span class="cc-legend-pct"><t t-esc="seg.count"/> (<t t-esc="seg.pct"/>%)</span>
                  </div>
                </t>
                <t t-if="state.data.grafica_subtipo.length === 0">
                  <span class="cc-legend-empty">Sin datos</span>
                </t>
              </div>
            </div>
          </div>

        </div>
      </t>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 4 – GRÁFICAS MENSUALES
           Visible para: Pet Sitter Manager únicamente
      ═══════════════════════════════════════════════════════════════════ -->
      <t t-if="state.data.user_is_manager">
        <div class="cc-charts-row cc-charts-row-2col">

          <div class="cc-chart-card cc-chart-bars">
            <div class="cc-chart-title">Ingresos por mes (últimos 12 meses)</div>
            <div class="cc-bar-chart cc-bar-chart-monthly">
              <t t-foreach="state.data.grafica_ingresos_mes" t-as="m" t-key="m.mes">
                <div class="cc-bar-group" t-att-title="m.mes + ': ' + m.ingresos_fmt">
                  <div class="cc-bar cc-bar-green" t-att-style="'height: ' + m.pct + '%'"/>
                  <span class="cc-bar-label"><t t-esc="m.mes_corto"/></span>
                </div>
              </t>
            </div>
          </div>

          <div class="cc-chart-card cc-chart-bars">
            <div class="cc-chart-title">Ocupaciones por mes (últimos 12 meses)</div>
            <div class="cc-bar-chart cc-bar-chart-monthly">
              <t t-foreach="state.data.grafica_ocupaciones_mes" t-as="m" t-key="m.mes">
                <div class="cc-bar-group" t-att-title="m.mes + ': ' + m.ocupaciones + ' ocupaciones'">
                  <div class="cc-bar cc-bar-blue" t-att-style="'height: ' + m.pct + '%'"/>
                  <span class="cc-bar-label"><t t-esc="m.mes_corto"/></span>
                </div>
              </t>
            </div>
          </div>

        </div>
      </t>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 5 – ÚLTIMAS OCUPACIONES
           Visible para: Pet Sitter Manager únicamente
      ═══════════════════════════════════════════════════════════════════ -->
      <t t-if="state.data.user_is_manager">
        <div class="cc-table-card">
          <div class="cc-chart-title">Últimas ocupaciones</div>
          <table class="cc-table">
            <thead>
              <tr>
                <th>Perro</th>
                <th>Cliente</th>
                <th>Servicio</th>
                <th>Jaula / Zona</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="state.data.ultimas" t-as="o" t-key="o.id">
                <tr>
                  <td class="cc-td-bold"><t t-esc="o.perro"/></td>
                  <td><t t-esc="o.cliente"/></td>
                  <td><t t-esc="o.subtipo"/></td>
                  <td class="cc-td-muted">
                    <t t-esc="o.jaula"/> <t t-if="o.zona">· <t t-esc="o.zona"/></t>
                  </td>
                  <td><t t-esc="o.entrada"/></td>
                  <td><t t-esc="o.salida !== '-' ? o.salida : '—'"/></td>
                  <td>
                    <span t-att-class="'cc-badge-estado ' + o.estado_class">
                      <t t-esc="o.estado_label"/>
                    </span>
                  </td>
                </tr>
              </t>
              <t t-if="state.data.ultimas.length === 0">
                <tr><td colspan="7" class="cc-td-empty">Sin ocupaciones en este periodo</td></tr>
              </t>
            </tbody>
          </table>
        </div>
      </t>

    </div>
  </t>

  <!-- ── ERROR ─────────────────────────────────────────────────────────── -->
  <t t-else="">
    <div class="cc-dashboard-loading">
      <span>No se pudieron cargar los datos del dashboard.</span>
      <button t-on-click="onRefresh">Reintentar</button>
    </div>
  </t>

</t>
</templates>