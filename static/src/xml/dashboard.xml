<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="centro_canino_dashboard.Dashboard" owl="1">

  <!-- ── LOADING ──────────────────────────────────────────────────────── -->
  <t t-if="state.loading">
    <div class="cc-dashboard-loading">
      <div class="cc-spinner"/>
      <span>Cargando dashboard…</span>
    </div>
  </t>

  <!-- ── DASHBOARD ────────────────────────────────────────────────────── -->
  <t t-elif="state.data">
    <div class="cc-dashboard">
<!-- ════════════════════════════════════════════════════════════════
     BUSCADOR DE RECEPCIÓN
═══════════════════════════════════════════════════════════════════ -->
<div class="cc-search-bar">

    <!-- Input siempre visible -->
    <div class="cc-search-input-wrap">
        <span class="cc-search-icon">🔍</span>
        <input type="text"
               class="cc-search-input"
               placeholder="Cliente, teléfono, nombre del perro..."
               t-att-value="state.searchText"
               t-on-input="onSearchInput"/>
        <button t-if="state.searchText"
                class="cc-search-clear"
                t-on-click="clearSearch">✕</button>
    </div>

    <!-- Spinner -->
    <t t-if="state.searchLoading">
        <div class="cc-search-searching">
            <span class="cc-search-spinner"/>
            Buscando...
        </div>
    </t>

    <!-- PASO 1: Desambiguación -->
    <t t-elif="state.searchStep === 'disambiguating'">
        <div class="cc-search-disambig-label">
            Varios resultados — ¿cuál de estos es?
        </div>
        <div class="cc-search-candidates">
            <t t-foreach="state.candidates" t-as="c" t-key="c.pet_id + '-' + c.partner_id">
                <div class="cc-search-candidate"
                     t-on-click="() => selectCandidate(c)">
                    <!-- Foto del perro -->
                    <div class="cc-search-candidate-photo">
                        <t t-if="c.pet_image">
                            <img t-att-src="'data:image/png;base64,' + c.pet_image"
                                 style="width:56px; height:56px; border-radius:50%; object-fit:cover;"/>
                        </t>
                        <t t-else="">
                            <span class="fa fa-paw"
                                  style="font-size:28px; color:#9CA3AF; line-height:56px;"/>
                        </t>
                    </div>
                    <!-- Datos -->
                    <div class="cc-search-candidate-info">
                        <div class="cc-search-candidate-pet">
                            🐾 <t t-esc="c.pet_name"/>
                        </div>
                        <div class="cc-search-candidate-client">
                            👤 <t t-esc="c.partner_name"/>
                        </div>
                        <div class="cc-search-candidate-phone">
                            📞 <t t-esc="c.partner_phone || 'Sin teléfono'"/>
                        </div>
                    </div>
                    <!-- Flecha -->
                    <div class="cc-search-candidate-arrow">→</div>
                </div>
            </t>
        </div>
    </t>

    <!-- PASO 2: Ficha operativa -->
    <t t-elif="state.searchStep === 'results' and state.searchResults">

        <!-- Cabecera del cliente seleccionado -->
        <div class="cc-search-selected-header">
            <div class="cc-search-selected-photo">
                <t t-if="state.selectedPet and state.selectedPet.pet_image">
                    <img t-att-src="'data:image/png;base64,' + state.selectedPet.pet_image"
                         style="width:48px; height:48px; border-radius:50%; object-fit:cover;"/>
                </t>
                <t t-else="">
                    <span class="fa fa-paw" style="font-size:24px; color:#9CA3AF;"/>
                </t>
            </div>
            <div class="cc-search-selected-info">
                <span class="cc-search-selected-pet">
                    🐾 <t t-esc="state.selectedPet and state.selectedPet.pet_name"/>
                </span>
                <span class="cc-search-selected-client">
                    👤 <t t-esc="state.searchResults.cliente"/>
                    <t t-if="state.searchResults.telefono">
                        · 📞 <t t-esc="state.searchResults.telefono"/>
                    </t>
                </span>
            </div>
            <button class="cc-search-back"
                    t-if="state.candidates.length > 1"
                    t-on-click="() => { state.searchStep = 'disambiguating'; }">
                ← Volver
            </button>
        </div>

        <!-- Resultados agrupados -->
        <t t-if="state.searchResults.items and state.searchResults.items.length > 0">

            <!-- VIVOS -->
            <t t-set="vivos" t-value="state.searchResults.items.filter(i => i.bloque === 'vivo')"/>
            <t t-if="vivos.length > 0">
                <div class="cc-search-section-label cc-search-label-vivo">
                    🟢 En el centro ahora
                </div>
                <t t-foreach="vivos" t-as="item" t-key="item.source_model + '-' + item.source_id">
                    <div class="cc-search-result-card cc-search-card-vivo"
                         t-on-click="() => openSearchResult(item)">
                        <div class="cc-search-card-left">
                            <span class="cc-search-card-desc">
                                <t t-esc="item.titulo"/>
                            </span>
                            <span class="cc-search-card-sub">
                                <t t-esc="item.descripcion"/>
                            </span>
                        </div>
                        <div class="cc-search-card-right">
                            <span class="cc-search-card-fecha">
                                <t t-esc="item.fecha_display"/>
                            </span>
                            <span class="cc-search-card-accion">
                                <t t-esc="item.accion_label"/> →
                            </span>
                        </div>
                    </div>
                </t>
            </t>

            <!-- ESPERA -->
            <t t-set="espera" t-value="state.searchResults.items.filter(i => i.bloque === 'espera')"/>
            <t t-if="espera.length > 0">
                <div class="cc-search-section-label cc-search-label-espera">
                    🟡 Pendientes de confirmar
                </div>
                <t t-foreach="espera" t-as="item" t-key="item.source_model + '-' + item.source_id">
                    <div class="cc-search-result-card cc-search-card-espera"
                         t-on-click="() => openSearchResult(item)">
                        <div class="cc-search-card-left">
                            <span class="cc-search-card-desc">
                                <t t-esc="item.titulo"/>
                            </span>
                            <span class="cc-search-card-sub">
                                <t t-esc="item.descripcion"/>
                            </span>
                        </div>
                        <div class="cc-search-card-right">
                            <span class="cc-search-card-fecha">
                                <t t-esc="item.fecha_display"/>
                            </span>
                            <span class="cc-search-card-accion cc-search-accion-alert">
                                <t t-esc="item.accion_label"/> →
                            </span>
                        </div>
                    </div>
                </t>
            </t>

            <!-- HISTÓRICO -->
            <t t-set="historico" t-value="state.searchResults.items.filter(i => i.bloque === 'historico')"/>
            <t t-if="historico.length > 0">
                <div class="cc-search-section-label cc-search-label-historico">
                    ⚫ Historial reciente
                </div>
                <t t-foreach="historico" t-as="item" t-key="item.source_model + '-' + item.source_id">
                    <div class="cc-search-result-card cc-search-card-historico"
                         t-on-click="() => openSearchResult(item)">
                        <div class="cc-search-card-left">
                            <span class="cc-search-card-desc">
                                <t t-esc="item.titulo"/>
                            </span>
                            <span class="cc-search-card-sub">
                                <t t-esc="item.descripcion"/>
                            </span>
                        </div>
                        <div class="cc-search-card-right">
                            <span class="cc-search-card-fecha">
                                <t t-esc="item.fecha_display"/>
                            </span>
                            <span class="cc-search-card-accion">
                                <t t-esc="item.accion_label"/> →
                            </span>
                        </div>
                    </div>
                </t>
            </t>

        </t>
        <t t-else="">
            <div class="cc-search-empty">
                No hay actividad registrada para este cliente.
            </div>
        </t>
    </t>

    <!-- Sin resultados -->
    <t t-elif="state.searchStep === 'no_results'">
        <div class="cc-search-empty">
            No se han encontrado resultados para
            "<t t-esc="state.searchText"/>"
        </div>
    </t>

</div>
      <!-- TOP BAR -->
      <div class="cc-topbar">
        <div class="cc-topbar-title">
          <span class="cc-paw">🐾</span>
          <h1>Centro Canino — Dashboard</h1>
        </div>
        <div class="cc-controls">
          <select t-on-change="onSubtipoChange" class="cc-select">
            <option value="">Todos los servicios</option>
            <t t-foreach="state.data.subtipos" t-as="s" t-key="s.id">
              <option t-att-value="s.id"
                      t-att-selected="state.filtroSubtipo == s.id">
                <t t-esc="s.name"/>
              </option>
            </t>
          </select>
          <select t-on-change="onPeriodoChange" class="cc-select" t-att-value="state.periodo">
            <option value="7"   t-att-selected="state.periodo === '7'">Últimos 7 días</option>
            <option value="30"  t-att-selected="state.periodo === '30'">Últimos 30 días</option>
            <option value="90"  t-att-selected="state.periodo === '90'">Últimos 90 días</option>
            <option value="365" t-att-selected="state.periodo === '365'">Este año</option>
            <option value="all" t-att-selected="state.periodo === 'all'">Todo el historial</option>
          </select>
          <button class="cc-btn-refresh" t-on-click="onRefresh" title="Actualizar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 4v6h-6M1 20v-6h6"/>
              <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 1 – KPIs HOY
           Visible para: Pet Sitter User + Pet Sitter Manager
      ═══════════════════════════════════════════════════════════════════ -->
      <!-- ════════════════════════════════════════════════════════════════
     FILA 1 – KPIs OPERATIVA DIARIA
     Visible para: Pet Sitter User + Pet Sitter Manager
═══════════════════════════════════════════════════════════════════ -->
<div class="cc-section">
  <span class="cc-badge">Operativa diaria</span>
  <div class="cc-metrics">

    <!-- AHORA -->
    <div class="cc-metric" t-on-click="() => openOcupaciones('in')">
      <div class="cc-metric-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M4.5 11a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM19.5 11a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"/>
          <path d="M8.5 7a4 4 0 017 0"/>
          <ellipse cx="12" cy="16" rx="5" ry="4"/>
          <path d="M9 20c0 1.1.9 2 2 2h2a2 2 0 002-2"/>
        </svg>
      </div>

      <span class="cc-metric-label">Ahora</span>
      <span class="cc-metric-value">
        <t t-esc="state.data.ahora.ocupaciones"/>
      </span>

      <span class="cc-metric-sub">
        <t t-esc="state.data.ahora.bungalows_ocupados"/> bungalows ocupados
      </span>

      <div class="cc-metric-breakdown">
        <span class="cc-mini-pill cc-mini-pill-night">
          🌙 <t t-esc="state.data.ahora.desglose.con_pernocta"/> pernocta
        </span>
        <span class="cc-mini-pill cc-mini-pill-day">
          ☀️ <t t-esc="state.data.ahora.desglose.sin_pernocta"/> sin pernocta
        </span>
      </div>

      <div class="cc-metric-breakdown cc-metric-breakdown-subtypes">
        <t t-foreach="state.data.ahora.desglose.subtipos" t-as="sub" t-key="'ahora-' + sub.id">
          <span t-att-class="sub.overnight_stay ? 'cc-mini-pill cc-mini-pill-subtype-night' : 'cc-mini-pill cc-mini-pill-subtype-day'">
            <t t-esc="sub.count"/> <t t-esc="sub.name"/>
          </span>
        </t>
      </div>
    </div>

    <!-- HOY -->
    <div class="cc-metric">
      <div class="cc-metric-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <path d="M16 2v4M8 2v4M3 10h18"/>
          <circle cx="12" cy="16" r="2" fill="currentColor"/>
        </svg>
      </div>

      <span class="cc-metric-label">Hoy</span>
      <span class="cc-metric-value">
        <t t-esc="state.data.hoy.ocupaciones"/>
      </span>

      <span class="cc-metric-sub">
        <t t-esc="state.data.hoy.bungalows_estimados"/> bungalows estimados
      </span>

      <div class="cc-metric-breakdown">
        <span class="cc-mini-pill cc-mini-pill-night">
          🌙 <t t-esc="state.data.hoy.desglose.con_pernocta"/> pernocta
        </span>
        <span class="cc-mini-pill cc-mini-pill-day">
          ☀️ <t t-esc="state.data.hoy.desglose.sin_pernocta"/> sin pernocta
        </span>
      </div>

      <div class="cc-metric-breakdown cc-metric-breakdown-subtypes">
        <t t-foreach="state.data.hoy.desglose.subtipos" t-as="sub" t-key="'hoy-' + sub.id">
          <span t-att-class="sub.overnight_stay ? 'cc-mini-pill cc-mini-pill-subtype-night' : 'cc-mini-pill cc-mini-pill-subtype-day'">
            <t t-esc="sub.count"/> <t t-esc="sub.name"/>
          </span>
        </t>
      </div>
    </div>

    <!-- OCUPACIÓN REAL -->
    <div class="cc-metric">
      <div class="cc-metric-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
      </div>
      <span class="cc-metric-label">Ocupación</span>
      <span class="cc-metric-value">
        <t t-esc="state.data.ahora.tasa_ocupacion"/>%
      </span>
      <span class="cc-metric-sub">
        <t t-esc="state.data.ahora.bungalows_ocupados"/> /
        <t t-esc="state.data.ahora.total_bungalows"/> bungalows
      </span>
    </div>

    <!-- ENTRADAS HOY -->
    <div class="cc-metric" t-on-click="() => openOcupaciones('checkin')">
      <div class="cc-metric-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/>
        </svg>
      </div>
      <span class="cc-metric-label">Entradas hoy</span>
      <span class="cc-metric-value">
        <t t-esc="state.data.movimiento.checkin_realizados"/>/<t t-esc="state.data.movimiento.checkin_previstos"/>
      </span>
      <span class="cc-metric-sub">
        Pendientes:
        <t t-esc="state.data.movimiento.checkin_pendientes"/>
      </span>
    </div>

    <!-- SALIDAS HOY -->
    <div class="cc-metric" t-on-click="() => openOcupaciones('checkout')">
      <div class="cc-metric-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
        </svg>
      </div>
      <span class="cc-metric-label">Salidas hoy</span>
      <span class="cc-metric-value">
        <t t-esc="state.data.movimiento.checkout_realizados"/>/<t t-esc="state.data.movimiento.checkout_previstos"/>
      </span>
      <span class="cc-metric-sub">
        Pendientes:
        <t t-esc="state.data.movimiento.checkout_pendientes"/>
      </span>
    </div>

    <!-- CUIDADOS ESPECIALES -->
    <div class="cc-metric cc-metric-alert"
         t-att-class="state.data.movimiento.alertas_medicas > 0 ? 'cc-metric cc-metric-alert' : 'cc-metric'"
         t-on-click="() => openOcupaciones('alertas')">
      <div class="cc-metric-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
        </svg>
      </div>
      <span class="cc-metric-label">Cuidados especiales</span>
      <span t-att-class="state.data.movimiento.alertas_medicas > 0 ? 'cc-metric-value cc-alert' : 'cc-metric-value'">
        <t t-esc="state.data.movimiento.alertas_medicas"/>
      </span>
    </div>

    <!-- BONOS -->
    <div class="cc-metric cc-metric-bonos" t-on-click="() => openBonos()">
      <div class="cc-metric-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="2" y="7" width="20" height="10" rx="2"/>
          <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
          <line x1="12" y1="12" x2="12" y2="12" stroke-width="3"/>
          <path d="M8 12h.01M12 12h.01M16 12h.01" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="cc-metric-label">Bonos con saldo</span>
      <span t-att-class="state.data.bonos_activos > 0 ? 'cc-metric-value cc-bonos' : 'cc-metric-value'">
        <t t-esc="state.data.bonos_activos"/>
      </span>
    </div>

  </div>
</div>
      <!-- ════════════════════════════════════════════════════════════════
           FILA ESCUELAS — Visible para todos
      ═══════════════════════════════════════════════════════════════════ -->
      <t t-if="state.data.escuelas">
        <div class="cc-section">
          <span class="cc-badge cc-badge-escuela">🎓 Escuelas</span>
          <div class="cc-metrics">

            <div class="cc-metric"
                 t-on-click="() => openEscuelas('activas')">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
              </div>
              <span class="cc-metric-label">Matrículas activas</span>
              <span t-att-class="state.data.escuelas.matriculas_activas > 0 ? 'cc-metric-value cc-positive' : 'cc-metric-value'">
                <t t-esc="state.data.escuelas.matriculas_activas"/>
              </span>
            </div>

            <div class="cc-metric"
                 t-on-click="() => openEscuelas('en_centro')">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                  <path d="M9 22V12h6v10"/>
                  <circle cx="12" cy="7" r="1" fill="currentColor"/>
                </svg>
              </div>
              <span class="cc-metric-label">Perros en centro</span>
              <span t-att-class="state.data.escuelas.perros_en_centro_escuela > 0 ? 'cc-metric-value cc-teal' : 'cc-metric-value'">
                <t t-esc="state.data.escuelas.perros_en_centro_escuela"/>
              </span>
            </div>

            <div class="cc-metric"
                 t-on-click="() => openEscuelas('sesiones_hoy')">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="4" width="18" height="18" rx="2"/>
                  <path d="M16 2v4M8 2v4M3 10h18"/>
                  <circle cx="12" cy="16" r="2" fill="currentColor"/>
                </svg>
              </div>
              <span class="cc-metric-label">Sesiones hoy</span>
              <span t-att-class="state.data.escuelas.sesiones_hoy > 0 ? 'cc-metric-value cc-warn' : 'cc-metric-value'">
                <t t-esc="state.data.escuelas.sesiones_hoy"/>
              </span>
            </div>

          </div>
        </div>
      </t>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 2 – KPIs PERIODO
           Visible para: Pet Sitter Manager únicamente
      ═══════════════════════════════════════════════════════════════════ -->
      <t t-if="state.data.user_is_manager">
        <div class="cc-section">
          <span class="cc-badge"><t t-esc="state.data.periodo.label_periodo"/></span>
          <div class="cc-metrics">

            <div class="cc-metric" t-on-click="() => openOcupaciones('reservas')">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="4" width="18" height="18" rx="2"/>
                  <path d="M16 2v4M8 2v4M3 10h18"/>
                  <path d="M9 16l2 2 4-4" stroke-width="2"/>
                </svg>
              </div>
              <span class="cc-metric-label">Total Reservas</span>
              <span class="cc-metric-value"><t t-esc="state.data.periodo.total_reservas"/></span>
            </div>

            <div class="cc-metric">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="2" y="6" width="20" height="14" rx="2"/>
                  <circle cx="12" cy="13" r="3"/>
                  <path d="M7 6V4a1 1 0 011-1h8a1 1 0 011 1v2"/>
                </svg>
              </div>
              <span class="cc-metric-label">Ingresos</span>
              <span class="cc-metric-value cc-positive"><t t-esc="state.data.periodo.ingresos_fmt"/></span>
            </div>

            <div class="cc-metric">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                </svg>
              </div>
              <span class="cc-metric-label">Cancelaciones</span>
              <span class="cc-metric-value cc-warn"><t t-esc="state.data.periodo.canceladas"/></span>
            </div>

            <div class="cc-metric">
              <div class="cc-metric-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <span class="cc-metric-label">Días promedio estancia</span>
              <span class="cc-metric-value"><t t-esc="state.data.periodo.dias_promedio"/></span>
            </div>

          </div>
        </div>
      </t>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 3 – GRÁFICAS
           Visible para: Pet Sitter Manager únicamente
      ═══════════════════════════════════════════════════════════════════ -->
      <t t-if="state.data.user_is_manager">
        <div class="cc-charts-row">

          <div class="cc-chart-card cc-chart-bars">
            <div class="cc-chart-title">Entradas por día</div>
            <div class="cc-bar-chart">
              <t t-foreach="state.data.grafica_diaria" t-as="dia" t-key="dia.fecha">
                <div class="cc-bar-group" t-att-title="dia.reservas + ' entradas el ' + dia.fecha">
                  <div class="cc-bar" t-att-style="'height: ' + dia.pct + '%'"/>
                  <span class="cc-bar-label"><t t-esc="dia.fecha"/></span>
                </div>
              </t>
            </div>
          </div>

          <div class="cc-chart-card cc-chart-donut">
            <div class="cc-chart-title">Por subtipo de servicio</div>
            <div class="cc-donut-wrap">
              <svg class="cc-donut-svg" viewBox="0 0 130 130" width="150" height="150">
                <circle cx="65" cy="65" r="54" fill="none" stroke="#e0e4ea" stroke-width="16"/>
                <t t-foreach="state.data.grafica_subtipo" t-as="seg" t-key="seg.id">
                  <circle
                    cx="65" cy="65" r="54"
                    fill="none"
                    t-att-stroke="seg.color"
                    stroke-width="16"
                    t-att-stroke-dasharray="seg.dash_array"
                    t-att-stroke-dashoffset="seg.dash_offset"
                    transform="rotate(-90 65 65)"
                  >
                    <title><t t-esc="seg.name"/>: <t t-esc="seg.count"/> (<t t-esc="seg.pct"/>%)</title>
                  </circle>
                </t>
                <text x="65" y="62" text-anchor="middle" class="cc-donut-num">
                  <t t-esc="state.data.periodo.total_reservas"/>
                </text>
                <text x="65" y="76" text-anchor="middle" class="cc-donut-sub">reservas</text>
              </svg>
              <div class="cc-donut-legend">
                <t t-foreach="state.data.grafica_subtipo" t-as="seg" t-key="seg.id">
                  <div class="cc-legend-item">
                    <span class="cc-legend-dot" t-att-style="'background: ' + seg.color"/>
                    <span class="cc-legend-name"><t t-esc="seg.name"/></span>
                    <span class="cc-legend-pct"><t t-esc="seg.count"/> (<t t-esc="seg.pct"/>%)</span>
                  </div>
                </t>
                <t t-if="state.data.grafica_subtipo.length === 0">
                  <span class="cc-legend-empty">Sin datos</span>
                </t>
              </div>
            </div>
          </div>

        </div>
      </t>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 4 – GRÁFICAS MENSUALES
           Visible para: Pet Sitter Manager únicamente
      ═══════════════════════════════════════════════════════════════════ -->
      <t t-if="state.data.user_is_manager">
        <div class="cc-charts-row cc-charts-row-2col">

          <div class="cc-chart-card cc-chart-bars">
            <div class="cc-chart-title">Ingresos por mes (últimos 12 meses)</div>
            <div class="cc-bar-chart cc-bar-chart-monthly">
              <t t-foreach="state.data.grafica_ingresos_mes" t-as="m" t-key="m.mes">
                <div class="cc-bar-group" t-att-title="m.mes + ': ' + m.ingresos_fmt">
                  <div class="cc-bar cc-bar-green" t-att-style="'height: ' + m.pct + '%'"/>
                  <span class="cc-bar-label"><t t-esc="m.mes_corto"/></span>
                </div>
              </t>
            </div>
          </div>

          <div class="cc-chart-card cc-chart-bars">
            <div class="cc-chart-title">Ocupaciones por mes (últimos 12 meses)</div>
            <div class="cc-bar-chart cc-bar-chart-monthly">
              <t t-foreach="state.data.grafica_ocupaciones_mes" t-as="m" t-key="m.mes">
                <div class="cc-bar-group" t-att-title="m.mes + ': ' + m.ocupaciones + ' ocupaciones'">
                  <div class="cc-bar cc-bar-blue" t-att-style="'height: ' + m.pct + '%'"/>
                  <span class="cc-bar-label"><t t-esc="m.mes_corto"/></span>
                </div>
              </t>
            </div>
          </div>

        </div>
      </t>

      <!-- ════════════════════════════════════════════════════════════════
           FILA 5 – ÚLTIMAS OCUPACIONES
           Visible para: Pet Sitter Manager únicamente
      ═══════════════════════════════════════════════════════════════════ -->
      <t t-if="state.data.user_is_manager">
        <div class="cc-table-card">
          <div class="cc-chart-title">Últimas ocupaciones</div>
          <table class="cc-table">
            <thead>
              <tr>
                <th>Perro</th>
                <th>Cliente</th>
                <th>Servicio</th>
                <th>Jaula / Zona</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="state.data.ultimas" t-as="o" t-key="o.id">
                <tr>
                  <td class="cc-td-bold"><t t-esc="o.perro"/></td>
                  <td><t t-esc="o.cliente"/></td>
                  <td><t t-esc="o.subtipo"/></td>
                  <td class="cc-td-muted">
                    <t t-esc="o.jaula"/> <t t-if="o.zona">· <t t-esc="o.zona"/></t>
                  </td>
                  <td><t t-esc="o.entrada"/></td>
                  <td><t t-esc="o.salida !== '-' ? o.salida : '—'"/></td>
                  <td>
                    <span t-att-class="'cc-badge-estado ' + o.estado_class">
                      <t t-esc="o.estado_label"/>
                    </span>
                  </td>
                </tr>
              </t>
              <t t-if="state.data.ultimas.length === 0">
                <tr><td colspan="7" class="cc-td-empty">Sin ocupaciones en este periodo</td></tr>
              </t>
            </tbody>
          </table>
        </div>
      </t>

    </div>
  </t>

  <!-- ── ERROR ─────────────────────────────────────────────────────────── -->
  <t t-else="">
    <div class="cc-dashboard-loading">
      <span>No se pudieron cargar los datos del dashboard.</span>
      <button t-on-click="onRefresh">Reintentar</button>
    </div>
  </t>

</t>
</templates>